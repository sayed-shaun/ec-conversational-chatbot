# Copy to .env and fill in. Anything commented out falls back to a default;
# see src/core/config.py for the full list and the reasoning behind each.

# --- Services you bring -----------------------------------------------------

# llama-server. Must be started with --jinja, or tool calling silently fails.
LLAMA_BASE_URL=http://YOUR_LLAMA_HOST:8080/v1

# Embedding search for the search_ec_services tool. Must return `top_similar`
# entries with `tag` and `cosine_similarity`.
TOP_SIMILAR_API_URL=http://YOUR_TOP_SIMILAR_HOST:8002/ec_bot/top_similar/

# Speech service: /v1/audio/transcriptions and /v1/audio/speech.
# Required for voice; leave unset to run text-only.
ASR_TTS_URL=http://YOUR_SPEECH_HOST:8000

# Upstream smart bot. Set it and every turn goes here first; only a turn it
# declines reaches the LLM. Empty = no hybrid, every turn goes to the LLM.
SMART_BOT_URL=http://YOUR_SMART_BOT_HOST:8002
# SMART_BOT_TIMEOUT=60
# SMART_BOT_USE_LLM_SELECTOR=true
# Sent as the model name; llama-server ignores it.
# LLAMA_MODEL=local-model

# --- Knowledge base ---------------------------------------------------------

# Raw URL of tag_answer.json, plus a PAT if that repo is private.
TAG_ANSWER_URL=https://raw.githubusercontent.com/YOUR_ORG/YOUR_DATASET_REPO/BRANCH/full_dataset/tag_answer.json
GITHUB_TOKEN=
# Re-fetch interval in seconds; 0 = fetch once at startup.
# TAG_ANSWER_REFRESH_SECONDS=43200
# false = fail startup loudly instead of using the bundled snapshot.
# TAG_ANSWER_ALLOW_LOCAL_FALLBACK=true

# Below this cosine score the bot says it doesn't know.
# CONFIDENCE_THRESHOLD=0.55

# --- Chatbot ----------------------------------------------------------------

# The only port published on the host.
PORT=9100

# MAX_HISTORY_TURNS=12
# SESSION_DB_PATH=/data/sessions.db
# Idle minutes before a transcript is deleted; 0 disables expiry.
# SESSION_TTL_MINUTES=60
# SESSION_SWEEP_MINUTES=10

# Comma-separated origins, for a UI hosted elsewhere (e.g. Vercel).
# CORS_ALLOW_ORIGINS=*

# ASR_LANGUAGE=bn
# ASR_TIMEOUT=60
# Dump every received clip here for debugging; off unless set.
# ASR_DUMP_DIR=
# Prefer llama-server's own --reasoning off; this is unreliable when streaming.
# LLAMA_REASONING_EFFORT=

# --- Tracing ----------------------------------------------------------------

# Off unless set. Records each turn's question, reply and voice audio -- a
# citizen's own words, so turn it on deliberately and keep the TTL.
# TRACE_DIR=/data/tracing
# Days a recording is kept; 0 keeps them forever.
# TRACE_TTL_DAYS=7
# TRACE_SWEEP_HOURS=6

# --- Caddy and tunnelling ---------------------------------------------------

# Upstreams Caddy publishes alongside this API, host:port.
LLAMA_UPSTREAM=YOUR_LLAMA_HOST:8080
EC_LLM_UPSTREAM=YOUR_EC_LLM_HOST:8006

# Optional public tunnel, for a UI hosted off this network.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# LOG_LEVEL=INFO
# TZ=Asia/Dhaka
