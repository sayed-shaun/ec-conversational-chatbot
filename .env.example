# --------------------------------------------------------------------------
# llama.cpp inference service (ghcr.io/ggml-org/llama.cpp:server-cuda)
# --------------------------------------------------------------------------
# GGUF model to auto-download from Hugging Face on first start.
# Example: HF_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF, HF_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
# Pick a model that supports tool/function calling -- this whole pipeline
# depends on it (Qwen2.5-Instruct, Llama-3.1/3.2-Instruct, Hermes-2-Pro, etc.)
# NOTE: this repo splits Q4_K_M into two shards; a bare
# 'qwen2.5-7b-instruct-q4_k_m.gguf' does not exist and will 404. Point at
# the first shard, or pick a smaller single-file model.
HF_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
HF_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
HF_TOKEN=

# llama-server tuning
PORT=8080
PARALLEL=4
CTX_SIZE=16384
NGL=99
FLASH_ATTN=on
# Extra raw CLI args appended to `llama-server`.
#   --jinja      REQUIRED for tool calling on most models (Qwen2.5, Gemma).
#                Without it llama-server never emits `tool_calls` and the
#                bot answers from the model instead of your FAQ data.
#   --no-mmproj  Skip the vision projector on multimodal GGUFs (Gemma 3n/4).
#                Saves ~1 GB of download and VRAM; without it a 4 GB card
#                CUDA-OOMs in a restart loop. This bot is text-only.
EXTRA_ARGS=--jinja --no-mmproj

# The model name the chatbot passes in its OpenAI-style requests.
# llama-server generally ignores this, but keep it descriptive.
LLAMA_MODEL=local-model

# --------------------------------------------------------------------------
# MCP server (search_faq tool)
# --------------------------------------------------------------------------
# VERIFY the exact path against http://<host>:8002/docs before deploying --
# this is a best guess based on the operation id you shared.
TOP_SIMILAR_API_URL=http://172.31.60.228:8002/ec_bot/top_similar/

# Below this cosine similarity score, the bot will say it doesn't know
# instead of confidently giving a possibly-wrong answer.
CONFIDENCE_THRESHOLD=0.55

# --------------------------------------------------------------------------
# Chatbot backend
# --------------------------------------------------------------------------
# How many past user+assistant turns to keep per session.
MAX_HISTORY_TURNS=12

# SQLite file holding conversation checkpoints, so transcripts survive a
# restart. Lives in the chat-sessions volume.
SESSION_DB_PATH=/data/sessions.db

# A chat has no end signal over HTTP, so a conversation is treated as finished
# once it goes idle: its transcript is cleared after this many minutes without
# a turn. Set 0 to keep transcripts until the user resets explicitly.
SESSION_TTL_MINUTES=60
SESSION_SWEEP_MINUTES=10

# ---------------------------------------------------------------------------
# MCP knowledge base (fetched live from GitHub when the MCP server starts)
# ---------------------------------------------------------------------------
# Raw URL of tag_answer.json. Defaults to the development branch of
# Synesis-IT-PLC/ec-faq-bot; that repo is private, so a token is required.
TAG_ANSWER_URL=https://raw.githubusercontent.com/Synesis-IT-PLC/ec-faq-bot/development/full_dataset/tag_answer.json
# GitHub PAT with read access to the repo above. Without it the fetch 404s
# and the server falls back to the bundled src/mcp/tag_answer.json.
GITHUB_TOKEN=

# Log level shared by both services (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
