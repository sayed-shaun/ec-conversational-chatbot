# --------------------------------------------------------------------------
# llama-server (bring your own)
# --------------------------------------------------------------------------
# This repo does not run llama.cpp -- point this at a llama-server you
# already have running. Defaults to the one on the same host as ASR_URL/
# OCR_URL below; override for a llama-server reachable elsewhere.
# It must be started with --jinja, or tool calling silently fails and the
# bot answers from the model instead of your FAQ data.
LLAMA_BASE_URL=http://172.31.60.228:8080/v1

# --------------------------------------------------------------------------
# Speech-to-text (voice input)
# --------------------------------------------------------------------------
# Base URL of the ASR service (same host as OCR_URL below -- both are routes
# on the same vision/speech API). Caddy proxies /asr* straight through to it,
# so the browser only ever talks to this stack's public origin -- an HTTPS
# page cannot call a plain-HTTP ASR service directly (mixed content), and
# routing it here also means the UI needs no second URL configured.
ASR_URL=http://172.31.60.228:8006

# --------------------------------------------------------------------------
# OCR (image text extraction)
# --------------------------------------------------------------------------
# Base URL of the vision/OCR service. Caddy proxies /ocr* to it (stripping
# the /ocr prefix, since the service's own route is /api/v1/vision/ocr), for
# the same same-origin/mixed-content reasons as ASR_URL above.
OCR_URL=http://172.31.60.228:8006

# Forwarded as reasoning_effort on chat-completion requests. Note this proved
# unreliable through the streaming path (the thinking pass still fired on some
# requests); prefer llama-server's own --reasoning off, see the README section
# "Latency: the pause before an answer starts". Leave empty for the model's
# default.
LLAMA_REASONING_EFFORT=

# --------------------------------------------------------------------------
# Host port
# --------------------------------------------------------------------------
# The only port published on the host. The MCP server stays on the internal
# compose network, so nothing unauthenticated is exposed; use
# `docker compose exec` to poke at it while debugging.
#   http://localhost:${PORT}/static/index.html   chat UI
#   http://localhost:${PORT}/docs                FastAPI interactive docs
#   http://localhost:${PORT}/health              health check
PORT=9100

# --------------------------------------------------------------------------
# MCP server (search_faq tool)
# --------------------------------------------------------------------------
# TOP_SIMILAR_API_URL is not set here -- docker-compose.yml already points it
# at the self-hosted pgvector service (ec-conversational-vector) over the
# internal compose network. Set it only if you want to use a different
# top_similar backend.

# Below this cosine similarity score, the bot will say it doesn't know
# instead of confidently giving a possibly-wrong answer.
CONFIDENCE_THRESHOLD=0.55

# --------------------------------------------------------------------------
# Vector search service (pgvector) -- self-hosted top_similar backend
# --------------------------------------------------------------------------
# Postgres credentials, shared by pgvector-db and ec-faq-vector.
VECTOR_DB_USER=ec_faq
VECTOR_DB_PASSWORD=ec_faq
VECTOR_DB_NAME=ec_faq

# fastembed model used to embed questions -- runs via ONNX (no torch), no
# outbound calls after the ~2.24GB weights are cached in the
# vector-model-cache volume. Not in fastembed's built-in registry; it's
# registered as a custom model in src/vector/embeddings.py, which also
# applies the E5-instruct query prefix. Must stay in sync with
# VECTOR_EMBEDDING_DIM.
VECTOR_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large-instruct
VECTOR_EMBEDDING_DIM=1024

# ec-faq-vector reindexes itself daily from these two files (same source
# TAG_ANSWER_URL/GITHUB_TOKEN below point at), joining question_tag.csv's
# paraphrases onto tag_answer.json's answers and rebuilding the whole
# faq_entries table -- see "Keeping the index in sync" in the README.
QUESTION_TAG_CSV_URL=https://raw.githubusercontent.com/Synesis-IT-PLC/ec-faq-bot/feat/multilingual-en-banglish-questions/full_dataset/question_tag.csv
# true/false. Manual POST /reindex works either way.
VECTOR_REINDEX_ENABLED=true
# UTC hour (0-23) the daily reindex runs at.
VECTOR_REINDEX_HOUR_UTC=3

# --------------------------------------------------------------------------
# Chatbot backend
# --------------------------------------------------------------------------
# How many past user+assistant turns to keep per session.
MAX_HISTORY_TURNS=12

# SQLite file holding conversation checkpoints, so transcripts survive a
# restart. Lives in the chat-sessions volume.
SESSION_DB_PATH=/data/sessions.db

# A chat has no end signal over HTTP, so a conversation is treated as finished
# once it goes idle: its transcript is cleared after this many minutes without
# a turn. Set 0 to keep transcripts until the user resets explicitly.
SESSION_TTL_MINUTES=60
SESSION_SWEEP_MINUTES=10

# Origins allowed to call this API cross-origin, comma-separated. Needed if
# the UI is hosted separately from this backend (e.g. on Vercel). '*' is the
# default since no cookies/auth headers are used; lock it to your deployed
# UI's origin once you know it, e.g.:
#   CORS_ALLOW_ORIGINS=https://your-project.vercel.app
CORS_ALLOW_ORIGINS=*

# --------------------------------------------------------------------------
# Public tunnel (optional -- only for exposing this backend to a UI hosted
# elsewhere, e.g. on Vercel). Starts only with:
#   docker compose --profile public up -d
# --------------------------------------------------------------------------
# From https://dashboard.ngrok.com/get-started/your-authtoken. Required only
# when the "public" profile is active; leaving it unset does not affect a
# plain `docker compose up`.
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------
# MCP knowledge base (fetched live from GitHub when the MCP server starts)
# ---------------------------------------------------------------------------
# Raw URL of tag_answer.json. Defaults to the development branch of
# Synesis-IT-PLC/ec-faq-bot; that repo is private, so a token is required.
TAG_ANSWER_URL=https://raw.githubusercontent.com/Synesis-IT-PLC/ec-faq-bot/development/full_dataset/tag_answer.json
# GitHub PAT with read access to the repo above. Without it the fetch 404s
# and the server falls back to the bundled src/mcp/tag_answer.json.
GITHUB_TOKEN=

# Re-fetch TAG_ANSWER_URL on this interval so a GitHub-side edit reaches a
# running server without a restart. 0 (default) fetches once at startup only.
TAG_ANSWER_REFRESH_SECONDS=43200

# Log level shared by both services (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
